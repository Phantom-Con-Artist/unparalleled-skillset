{
  "name": "unparalleled",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "unparalleled",
      "version": "1.0.0",
      "license": "MIT",
      "workspaces": [
        "site",
        "packages/*"
      ],
      "bin": {
        "unparalleled": "bin/cli.js",
        "unparalleled-skillset": "bin/cli.js",
        "unparalleled-studio": "packages/studio-engine/src/cli.mjs",
        "unparalleled-studio-agent": "packages/studio-agent-tools/src/cli.mjs",
        "unparalleled-ui": "bin/cli.js",
        "unparalleled-website": "bin/cli.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@unparalleled/studio-adapters": {
      "resolved": "packages/studio-adapters",
      "link": true
    },
    "node_modules/@unparalleled/studio-agent-tools": {
      "resolved": "packages/studio-agent-tools",
      "link": true
    },
    "node_modules/@unparalleled/studio-browser-extension": {
      "resolved": "packages/studio-browser-extension",
      "link": true
    },
    "node_modules/@unparalleled/studio-engine": {
      "resolved": "packages/studio-engine",
      "link": true
    },
    "node_modules/@unparalleled/studio-overlay": {
      "resolved": "packages/studio-overlay",
      "link": true
    },
    "node_modules/@unparalleled/studio-protocol": {
      "resolved": "packages/studio-protocol",
      "link": true
    },
    "node_modules/unparalleled-site": {
      "resolved": "site",
      "link": true
    },
    "packages/studio-adapters": {
      "name": "@unparalleled/studio-adapters",
      "version": "0.1.0"
    },
    "packages/studio-agent-tools": {
      "name": "@unparalleled/studio-agent-tools",
      "version": "0.1.0",
      "bin": {
        "unparalleled-studio-agent": "src/cli.mjs"
      }
    },
    "packages/studio-browser-extension": {
      "name": "@unparalleled/studio-browser-extension",
      "version": "0.1.0"
    },
    "packages/studio-engine": {
      "name": "@unparalleled/studio-engine",
      "version": "0.1.0",
      "bin": {
        "unparalleled-studio": "src/cli.mjs"
      }
    },
    "packages/studio-overlay": {
      "name": "@unparalleled/studio-overlay",
      "version": "0.1.0"
    },
    "packages/studio-protocol": {
      "name": "@unparalleled/studio-protocol",
      "version": "0.1.0"
    },
    "site": {
      "name": "unparalleled-site",
      "workspaces": [
        "apps/*"
      ]
    }
  }
}
