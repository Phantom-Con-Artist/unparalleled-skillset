{
  "name": "unparalleled",
  "version": "1.0.0",
  "description": "Bespoke premium UI and immersive website design skills with original direction, authored assets, human writing, and evidence-based craft review.",
  "type": "module",
  "exports": {
    "./studio": "./packages/studio-engine/src/index.mjs",
    "./studio/vite": "./packages/studio-adapters/src/vite.mjs",
    "./studio/client": "./packages/studio-agent-tools/src/client.mjs",
    "./package.json": "./package.json",
    "./lib/*": "./lib/*",
    "./bin/*": "./bin/*"
  },
  "bin": {
    "unparalleled": "bin/cli.js",
    "unparalleled-skillset": "bin/cli.js",
    "unparalleled-ui": "bin/cli.js",
    "unparalleled-website": "bin/cli.js",
    "unparalleled-studio": "packages/studio-engine/src/cli.mjs",
    "unparalleled-studio-agent": "packages/studio-agent-tools/src/cli.mjs"
  },
  "files": [
    "bin",
    "lib",
    "packages/studio-*/**",
    ".agents/skills",
    "examples",
    "LICENSE",
    "README.md",
    "docs/installation.md"
  ],
  "workspaces": [
    "site",
    "packages/*"
  ],
  "scripts": {
    "validate-all": "node .agents/skills/unparalleled-ui/scripts/validate-skill.mjs && node .agents/skills/unparalleled-website/scripts/validate-skill.mjs",
    "check-contrast": "node .agents/skills/unparalleled-ui/scripts/check-contrast.mjs && node .agents/skills/unparalleled-website/scripts/check-contrast.mjs",
    "cli": "node ./bin/cli.js",
    "capture": "node .agents/skills/unparalleled-website/scripts/capture.mjs",
    "test": "node --test tests/*.test.mjs tests/studio/*.test.mjs",
    "test:studio": "node --test tests/studio/*.test.mjs",
    "studio": "node packages/studio-engine/src/cli.mjs",
    "studio:demo": "node packages/studio-engine/src/cli.mjs --demo --port 4310",
    "studio:agent": "node packages/studio-agent-tools/src/cli.mjs",
    "prepack": "npm run validate-all",
    "prepublishOnly": "npm test && npm run validate-all && npm run check-contrast",
    "site:dev": "node site/scripts/dev.mjs",
    "site:deploy": "npm run site:build && npm run deploy -w site",
    "pottery:dev": "npm --prefix site/apps/poterie-celeste run dev",
    "pottery:build": "npm --prefix site/apps/poterie-celeste run build",
    "site:build": "node site/scripts/build.mjs",
    "site:preview": "npm run site:build && npm run dev -w site",
    "home:dev": "npm --prefix site/apps/unparalleled run dev",
    "quantum:dev": "npm --prefix site/apps/soveriegn-quantum run dev",
    "quantum:build": "npm --prefix site/apps/soveriegn-quantum run build"
  },
  "keywords": [
    "agentic-skills",
    "antigravity",
    "gemini",
    "ui-design",
    "ux-design",
    "web-design",
    "design-systems",
    "aesthetic-philosophy"
  ],
  "author": "Subhradeep Sarkar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phantom-Con-Artist/unparalleled-skillset.git"
  },
  "homepage": "https://github.com/Phantom-Con-Artist/unparalleled-skillset#readme",
  "bugs": {
    "url": "https://github.com/Phantom-Con-Artist/unparalleled-skillset/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
