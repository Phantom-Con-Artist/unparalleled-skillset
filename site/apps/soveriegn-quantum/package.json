{
  "name": "soveriegn-quantum",
  "private": true,
  "type": "module",
  "description": "Soveriegn Quantum specimen site: React, React Three Fiber and GSAP around a Blender-built dilution refrigerator, built into site/public/soveriegn-quantum.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('fs').copyFileSync('../../public/soveriegn-quantum/index.html','../../public/soveriegn-quantum/404.html')\"",
    "preview": "vite preview",
    "prebuild": "node -e \"const p=require('path');require('fs').cpSync(p.join(p.dirname(require.resolve('three')),'..','examples/jsm/libs/draco/gltf'),'public/draco',{recursive:true})\"",
    "predev": "node -e \"const p=require('path');require('fs').cpSync(p.join(p.dirname(require.resolve('three')),'..','examples/jsm/libs/draco/gltf'),'public/draco',{recursive:true})\""
  },
  "dependencies": {
    "@fontsource-variable/azeret-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@gsap/react": "2.1.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5"
  }
}
